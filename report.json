  "emailBody": "\n        <html>\n\n        <body\n            style=\"\n                font-family:Segoe UI, Arial, sans-serif;\n                margin:20px;\n            \"\n        >\n\n            <div\n                style=\"\n                    background:#d42e12;\n                    color:white;\n                    padding:15px;\n                    border-radius:8px;\n                \"\n            >\n\n\n               <h1 style=\"margin:0;\">\n                    Fuel Market Intelligence Afternoon Report\n                </h1>\n\n                <p style=\"margin:5px 0 0 0;\">\n                    16 August 2026\n                </p>\n\n            </div>\n\n            <p\n                style=\"\n                    font-size:16px;\n                    margin-top:20px;\n                    margin-bottom:20px;\n                \"\n            >\n                Good afternoon Sir,\n                <br><br>\n                \n                Here is today's fuel market intelligence report highlighting\n                the latest PMS and AGO depot prices together with key industry\n                developments and market news.\n            </p>\n\n            <br>\n\n            \n        <h2 style=\"color:#d42e12;\">\n            PMS Prices\n        </h2>\n\n        <div\n            style=\"\n                background:#fad5a1;\n                padding:12px;\n                border-left:5px solid #f28e05;\n                margin-bottom:10px;\n                font-size:16px;\n                font-weight:bold;\n            \"\n        >\n            Average PMS Prices: ₦1,176.50/L\n        </div>\n\n        <table\n            width=\"100%\"\n            cellspacing=\"0\"\n            cellpadding=\"10\"\n            style=\"\n                border-collapse:collapse;\n                border:1px solid #ddd;\n            \"\n        >\n\n            <tr style=\"background:#d42e12;color:white;\">\n                <th align=\"left\">Depot</th>\n         